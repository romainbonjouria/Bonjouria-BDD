# Chaîne de connexion PostgreSQL (Supabase > Project Settings > Database > Connection string > "Transaction pooler", port 6543)
DATABASE_URL="postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres"

# Clé secrète pour signer les sessions (au moins 32 caractères aléatoires)
AUTH_SECRET="remplacez-moi-par-une-longue-chaine-aleatoire"

# Premier compte administrateur (utilisé uniquement par `npm run db:init`)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangezMoi123!"

# Détection du secteur par IA (facultatif) : renseigner UNE des deux clés.
# Sans clé, seul le registre officiel des entreprises est utilisé.
# Claude (prioritaire si présent) : https://console.anthropic.com
ANTHROPIC_API_KEY=""
# OpenAI : https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# Modèle OpenAI utilisé (par défaut gpt-5.4-mini)
# OPENAI_MODEL="gpt-5.4-mini"
# Modèle utilisé (par défaut claude-opus-5 ; claude-haiku-4-5 est ~5x moins cher)
# ANTHROPIC_MODEL="claude-opus-5"
