# Chaîne de connexion PostgreSQL (Supabase > Project Settings > Database > Connection string > "Transaction pooler", port 6543)
DATABASE_URL="postgresql://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:6543/postgres"

# Clé secrète pour signer les sessions (au moins 32 caractères aléatoires)
AUTH_SECRET="remplacez-moi-par-une-longue-chaine-aleatoire"

# Premier compte administrateur (utilisé uniquement par `npm run db:init`)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="ChangezMoi123!"
